# Copy to .env.local and fill in what you have. Everything is optional for local
# development: without DATABASE_URL an embedded Postgres (PGlite) is stored in
# ./.data, and the "demo account" lets you try the product without platform keys.

# --- Core ---
APP_URL=http://localhost:3000
# Signs session cookies and (unless TOKEN_ENCRYPTION_KEY is set) encrypts OAuth tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Optional separate 32-byte key (base64) for encrypting platform tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- Database ---
# Production: a Postgres URL (EU region). Leave empty to use embedded PGlite.
DATABASE_URL=

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# Override the model if needed (default: claude-opus-5-5)
MEPA_MODEL=

# --- Instagram (Instagram API with Instagram Login) ---
# https://developers.facebook.com/apps -> add the "Instagram" product
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- YouTube (Google OAuth: YouTube Data API v3 + YouTube Analytics API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok (Login Kit + Display API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Scheduled jobs ---
# Bearer token required by /api/cron/* endpoints.
CRON_SECRET=
